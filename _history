 (let x = 0; x &lt; 128; x += 16) {\" line1=\"\" line2=\"            let buf2 = pins.createBuffer(17)\" line3=\"            buf2[0] = 0x40\" line4=\"\" line5=\"            for (let k = 0; k &lt; 16; k++) {\" line6=\"                buf2[k + 1] = framebuffer[page2 * 128 + x + k]\" line7=\"            }\" line8=\"\" line9=\"            let result2 = pins.i2cWriteBuffer(OLED_ADDR, buf2, false)\" line10=\"\" line11=\"            if (result2 != 0) {\" line12=\"                serial.writeLine(&quot;I2C ERROR DATA: &quot; + result2)\" line13=\"            }\" line14=\"        }\" numlines=\"15\"></mutation></block></next></block></next></block></next></block></statement><next><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">OLED SHOW OK</field></shadow></value></block></next></block></next></block></statement></block></xml>","main.ts":"","README.md":"","sh1106.ts":"/**\n * SH1106 OLED 128x64\n * Biblioteka MakeCode dla micro:bit V2\n * Komunikacja I2C\n */\n//% color=\"#2675A6\" icon=\"\\uf108\" block=\"SH1106 OLED\"\nnamespace sh1106 {\n\n    const ADDRESS = 0x3C\n    const WIDTH = 128\n    const HEIGHT = 64\n\n    let framebuffer = pins.createBuffer(1024)\n    let initialized = false\n\n    function command(cmd: number): void {\n        let buf = pins.createBuffer(2)\n        buf[0] = 0x00\n        buf[1] = cmd\n        pins.i2cWriteBuffer(ADDRESS, buf, false)\n    }\n\n    /**\n     * Inicjalizuje wyswietlacz.\n     */\n    //% block=\"inicjalizuj OLED\"\n    //% weight=100\n    export function init(): void {\n        command(0xAE)\n\n        command(0xD5)\n        command(0x80)\n\n        command(0xA8)\n        command(0x3F)\n\n        command(0xD3)\n        command(0x00)\n\n        command(0x40)\n\n        command(0xAD)\n        command(0x8B)\n\n        command(0xA1)\n        command(0xC8)\n\n        command(0xDA)\n        command(0x12)\n\n        command(0x81)\n        command(0x80)\n\n        command(0xD9)\n        command(0x1F)\n\n        command(0xDB)\n        command(0x40)\n\n        command(0xA4)\n        command(0xA6)\n        command(0xAF)\n\n        initialized = true\n        clear()\n        show()\n    }\n\n    /**\n     * Czysci bufor obrazu.\n     */\n    //% block=\"wyczysc OLED\"\n    //% weight=90\n    export function clear(): void {\n        for (let i = 0; i < 1024; i++) {\n            framebuffer[i] = 0\n        }\n    }\n\n    /**\n     * Wysyla bufor na wyswietlacz.\n     */\n    //% block=\"pokaz obraz OLED\"\n    //% weight=80\n    export function show(): void {\n        if (!initialized) {\n            return\n        }\n\n        for (let page = 0; page < 8; page++) {\n            command(0xB0 + page)\n            command(0x02)\n            command(0x10)\n\n            for (let x = 0; x < WIDTH; x += 16) {\n                let buf = pins.createBuffer(17)\n                buf[0] = 0x40\n\n                for (let i = 0; i < 16; i++) {\n                    buf[i + 1] = framebuffer[page * WIDTH + x + i]\n                }\n\n                pins.i2cWriteBuffer(ADDRESS, buf, false)\n            }\n        }\n    }\n\n    /**\n     * Rysuje piksel.\n     */\n    //% block=\"piksel OLED X %x Y %y\"\n    //% x.min=0 x.max=127\n    //% y.min=0 y.max=63\n    //% weight=70\n    export function pixel(x: number, y: number): void {\n        if (x < 0 || x >= WIDTH || y < 0 || y >= HEIGHT) {\n            return\n        }\n\n        let page = Math.idiv(y, 8)\n        let index = page * WIDTH + x\n        let bit = y % 8\n\n        framebuffer[index] |= (1 << bit)\n    }\n\n    /**\n     * Rysuje linie.\n     */\n    //% block=\"linia OLED X1 %x0 Y1 %y0 X2 %x1 Y2 %y1\"\n    //% weight=60\n    export function line(\n        x0: number,\n        y0: number,\n        x1: number,\n        y1: number\n    ): void {\n\n        let dx = Math.abs(x1 - x0)\n        let dy = Math.abs(y1 - y0)\n\n        let sx = x0 < x1 ? 1 : -1\n        let sy = y0 < y1 ? 1 : -1\n\n        let err = dx - dy\n\n        while (true) {\n            pixel(x0, y0)\n\n            if (x0 == x1 && y0 == y1) {\n                break\n            }\n\n            let e2 = 2 * err\n\n            if (e2 > -dy) {\n                err -= dy\n                x0 += sx\n            }\n\n            if (e2 < dx) {\n                err += dx\n                y0 += sy\n            }\n        }\n    }\n\n    /**\n     * Rysuje prostokat.\n     */\n    //% block=\"prostokat OLED X %x Y %y szerokosc %w wysokosc %h wypelnij %fill\"\n    //% weight=50\n    export function rectangle(\n        x: number,\n        y: number,\n        w: number,\n        h: number,\n        fill: boolean\n    ): void {\n\n        if (w <= 0 || h <= 0) {\n            return\n        }\n\n        if (fill) {\n            for (let yy = y; yy < y + h; yy++) {\n                for (let xx = x; xx < x + w; xx++) {\n                    pixel(xx, yy)\n                }\n            }\n        } else {\n            line(x, y, x + w - 1, y)\n            line(x, y, x, y + h - 1)\n            line(x + w - 1, y, x + w - 1, y + h - 1)\n            line(x, y + h - 1, x + w - 1, y + h - 1)\n        }\n    }\n\n    /**\n     * Rysuje okrag.\n     */\n    //% block=\"okrag OLED X %cx Y %cy promien %r wypelnij %fill\"\n    //% weight=40\n    export function circle(\n        cx: number,\n        cy: number,\n        r: number,\n        fill: boolean\n    ): void {\n\n        if (r < 0) {\n            return\n        }\n\n        let x = r\n        let y = 0\n        let err = 1 - r\n\n        while (x >= y) {\n\n            if (fill) {\n                line(cx - x, cy + y, cx + x, cy + y)\n                line(cx - x, cy - y, cx + x, cy - y)\n                line(cx - y, cy + x, cx + y, cy + x)\n                line(cx - y, cy - x, cx + y, cy - x)\n            } else {\n                pixel(cx + x, cy + y)\n                pixel(cx + y, cy + x)\n                pixel(cx - y, cy + x)\n                pixel(cx - x, cy + y)\n                pixel(cx - x, cy - y)\n                pixel(cx - y, cy - x)\n                pixel(cx + y, cy - x)\n                pixel(cx + x, cy - y)\n            }\n\n            y++\n\n            if (err < 0) {\n                err += 2 * y + 1\n            } else {\n                x--\n                err += 2 * (y - x) + 1\n            }\n        }\n    }\n}","pxt.json":"{\n    \"name\": \"pxt-sh1106-oled\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"sh1106.ts\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}}],"shares":[],"lastSaveTime":1794958331062}