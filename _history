"diffs":[[1,"\n    let page = Math.idiv(y, 8)\n    let index = page * 128 + x\n    let bit = y % 8\n\n    framebuffer[index] |= (1 << bit)\n"]]},{"start1":1973,"length1":0,"diffs":[[1,"\n"]]},{"start1":2075,"length1":123,"diffs":[[1,"function oledLine(x0: number, y0: number, x1: number, y1: number) {\n    let dx = Math.abs(x1 - x0)\n    let dy = Math.abs(y1 - y0)\n\n"]]},{"start1":2236,"length1":40,"diffs":[[1,"    let sy = y0 < y1 ? 1 : -1\n\n    let err = dx - dy\n\n"]]},{"start1":2335,"length1":0,"diffs":[[1,"\n"]]},{"start1":2372,"length1":19,"diffs":[[1,"            break\n"]]},{"start1":2400,"length1":74,"diffs":[[1,"\n        let e2 = 2 * err\n\n        if (e2 > -dy) {\n            err -= dy\n"]]},{"start1":2504,"length1":0,"diffs":[[1,"\n"]]},{"start1":2589,"length1":0,"diffs":[[1,"\n"]]},{"start1":2695,"length1":70,"diffs":[[1,"function oledRectangle(x: number, y: number, w: number, h: number) {\n"]]},{"start1":2930,"length1":0,"diffs":[[1,"\n"]]},{"start1":2977,"length1":21,"diffs":[[1,"// Prosta czcionka 5x7\n// Litery: H E L O\n"]]},{"start1":3065,"length1":232,"diffs":[[1,"function oledChar(ch: string, x: number, y: number) {\n\n    let data: number[] = []\n\n    if (ch == \"H\") {\n        data = [0x7F, 0x08, 0x08, 0x08, 0x7F]\n    } else if (ch == \"E\") {\n        data = [0x7F, 0x49, 0x49, 0x49, 0x41]\n    } else if (ch == \"L\") {\n        data = [0x7F, 0x40, 0x40, 0x40, 0x40]\n    } else if (ch == \"O\") {\n        data = [0x3E, 0x41, 0x41, 0x41, 0x3E]\n"]]},{"start1":3444,"length1":0,"diffs":[[1,"\n    for (let col = 0; col < data.length; col++) {\n        for (let row = 0; row < 7; row++) {\n            if ((data[col] & (1 << row)) != 0) {\n                oledPixel(x + col, y + row)\n            }\n        }\n    }\n"]]},{"start1":3664,"length1":0,"diffs":[[1,"\n"]]},{"start1":3772,"length1":156,"diffs":[[1,"function oledHello(x: number, y: number) {\n    let txt = \"HELLO\"\n\n    for (let i = 0; i < txt.length; i++) {\n        oledChar(txt.charAt(i), x + i * 6, y)\n"]]},{"start1":3935,"length1":0,"diffs":[[1,"\n"]]},{"start1":4051,"length1":23,"diffs":[[1,"function oledShow() {\n\n"]]},{"start1":4114,"length1":80,"diffs":[[1,"\n    for (let page = 0; page < 8; page++) {\n\n        oledCommand(0xB0 + page)\n\n"]]},{"start1":4288,"length1":47,"diffs":[[1,"        oledCommand(0x02)\n        oledCommand(0x10)\n\n        // Wysylanie danych w porcjach po 16 bajtow\n"]]},{"start1":4438,"length1":72,"diffs":[[1,"            let buf = pins.createBuffer(17)\n            buf[0] = 0x40\n"]]},{"start1":4509,"length1":106,"diffs":[[1,"            for (let i = 0; i < 16; i++) {\n                buf[i + 1] = framebuffer[page * 128 + x + i]\n"]]},{"start1":4628,"length1":70,"diffs":[[1,"            let result = pins.i2cWriteBuffer(OLED_ADDR, buf, false)\n"]]},{"start1":4697,"length1":95,"diffs":[[1,"            if (result != 0) {\n                serial.writeLine(\"I2C ERROR DATA: \" + result)\n"]]},{"start1":4820,"length1":0,"diffs":[[1,"\n"]]},{"start1":4860,"length1":246,"diffs":[[1,"\n// ==========================================\n// PROGRAM GLOWNY\n// ==========================================\n\n"]]},{"start1":5034,"length1":0,"diffs":[[1,"\n"]]},{"start1":5052,"length1":0,"diffs":[[1,"\n"]]},{"start1":5064,"length1":0,"diffs":[[1,"\n"]]},{"start1":5077,"length1":0,"diffs":[[1,"\n"]]},{"start1":5116,"length1":0,"diffs":[[1,"\n"]]},{"start1":5178,"length1":0,"diffs":[[1,"\n"]]},{"start1":5206,"length1":0,"diffs":[[1,"\n"]]},{"start1":5218,"length1":0,"diffs":[[1,"\n"]]},{"start1":5255,"length1":30,"diffs":[[1,"\nbasic.showIcon(IconNames.Yes)"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":211,"length1":41,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":238,"length1":35,"diffs":[[1,"    \"preferredEditor\": \"tsprj\"\n"]]}]},{"type":"added","filename":"sh1106.ts","value":"/**\n * SH1106 OLED 128x64\n * Biblioteka MakeCode dla micro:bit V2\n * Komunikacja I2C\n */\n//% color=\"#2675A6\" icon=\"\\uf108\" block=\"SH1106 OLED\"\nnamespace sh1106 {\n\n    const ADDRESS = 0x3C\n    const WIDTH = 128\n    const HEIGHT = 64\n\n    let framebuffer = pins.createBuffer(1024)\n    let initialized = false\n\n    function command(cmd: number): void {\n        let buf = pins.createBuffer(2)\n        buf[0] = 0x00\n        buf[1] = cmd\n        pins.i2cWriteBuffer(ADDRESS, buf, false)\n    }\n\n    /**\n     * Inicjalizuje wyswietlacz.\n     */\n    //% block=\"inicjalizuj OLED\"\n    //% weight=100\n    export function init(): void {\n        command(0xAE)\n\n        command(0xD5)\n        command(0x80)\n\n        command(0xA8)\n        command(0x3F)\n\n        command(0xD3)\n        command(0x00)\n\n        command(0x40)\n\n        command(0xAD)\n        command(0x8B)\n\n        command(0xA1)\n        command(0xC8)\n\n        command(0xDA)\n        command(0x12)\n\n        command(0x81)\n        command(0x80)\n\n        command(0xD9)\n        command(0x1F)\n\n        command(0xDB)\n        command(0x40)\n\n        command(0xA4)\n        command(0xA6)\n        command(0xAF)\n\n        initialized = true\n        clear()\n        show()\n    }\n\n    /**\n     * Czysci bufor obrazu.\n     */\n    //% block=\"wyczysc OLED\"\n    //% weight=90\n    export function clear(): void {\n        for (let i = 0; i < 1024; i++) {\n            framebuffer[i] = 0\n        }\n    }\n\n    /**\n     * Wysyla bufor na wyswietlacz.\n     */\n    //% block=\"pokaz obraz OLED\"\n    //% weight=80\n    export function show(): void {\n        if (!initialized) {\n            return\n        }\n\n        for (let page = 0; page < 8; page++) {\n            command(0xB0 + page)\n            command(0x02)\n            command(0x10)\n\n            for (let x = 0; x < WIDTH; x += 16) {\n                let buf = pins.createBuffer(17)\n                buf[0] = 0x40\n\n                for (let i = 0; i < 16; i++) {\n                    buf[i + 1] = framebuffer[page * WIDTH + x + i]\n                }\n\n                pins.i2cWriteBuffer(ADDRESS, buf, false)\n            }\n        }\n    }\n\n    /**\n     * Rysuje piksel.\n     */\n    //% block=\"piksel OLED X %x Y %y\"\n    //% x.min=0 x.max=127\n    //% y.min=0 y.max=63\n    //% weight=70\n    export function pixel(x: number, y: number): void {\n        if (x < 0 || x >= WIDTH || y < 0 || y >= HEIGHT) {\n            return\n        }\n\n        let page = Math.idiv(y, 8)\n        let index = page * WIDTH + x\n        let bit = y % 8\n\n        framebuffer[index] |= (1 << bit)\n    }\n\n    /**\n     * Rysuje linie.\n     */\n    //% block=\"linia OLED X1 %x0 Y1 %y0 X2 %x1 Y2 %y1\"\n    //% weight=60\n    export function line(\n        x0: number,\n        y0: number,\n        x1: number,\n        y1: number\n    ): void {\n\n        let dx = Math.abs(x1 - x0)\n        let dy = Math.abs(y1 - y0)\n\n        let sx = x0 < x1 ? 1 : -1\n        let sy = y0 < y1 ? 1 : -1\n\n        let err = dx - dy\n\n        while (true) {\n            pixel(x0, y0)\n\n            if (x0 == x1 && y0 == y1) {\n                break\n            }\n\n            let e2 = 2 * err\n\n            if (e2 > -dy) {\n                err -= dy\n                x0 += sx\n            }\n\n            if (e2 < dx) {\n                err += dx\n                y0 += sy\n            }\n        }\n    }\n\n    /**\n     * Rysuje prostokat.\n     */\n    //% block=\"prostokat OLED X %x Y %y szerokosc %w wysokosc %h wypelnij %fill\"\n    //% weight=50\n    export function rectangle(\n        x: number,\n        y: number,\n        w: number,\n        h: number,\n        fill: boolean\n    ): void {\n\n        if (w <= 0 || h <= 0) {\n            return\n        }\n\n        if (fill) {\n            for (let yy = y; yy < y + h; yy++) {\n                for (let xx = x; xx < x + w; xx++) {\n                    pixel(xx, yy)\n                }\n            }\n        } else {\n            line(x, y, x + w - 1, y)\n            line(x, y, x, y + h - 1)\n            line(x + w - 1, y, x + w - 1, y + h - 1)\n            line(x, y + h - 1, x + w - 1, y + h - 1)\n        }\n    }\n\n    /**\n     * Rysuje okrag.\n     */\n    //% block=\"okrag OLED X %cx Y %cy promien %r wypelnij %fill\"\n    //% weight=40\n    export function circle(\n        cx: number,\n        cy: number,\n        r: number,\n        fill: boolean\n    ): void {\n\n        if (r < 0) {\n            return\n        }\n\n        let x = r\n        let y = 0\n        let err = 1 - r\n\n        while (x >= y) {\n\n            if (fill) {\n                line(cx - x, cy + y, cx + x, cy + y)\n                line(cx - x, cy - y, cx + x, cy - y)\n                line(cx - y, cy + x, cx + y, cy + x)\n                line(cx - y, cy - x, cx + y, cy - x)\n            } else {\n                pixel(cx + x, cy + y)\n                pixel(cx + y, cy + x)\n                pixel(cx - y, cy + x)\n                pixel(cx - x, cy + y)\n                pixel(cx - x, cy - y)\n                pixel(cx - y, cy - x)\n                pixel(cx + y, cy - x)\n                pixel(cx + x, cy - y)\n            }\n\n            y++\n\n            if (err < 0) {\n                err += 2 * y + 1\n            } else {\n                x--\n                err += 2 * (y - x) + 1\n            }\n        }\n    }\n}"}]},{"timestamp":1794957595776,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":1349,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"47m(5}];5y+I$7h*[Q?V\">buf</variable><variable id=\"M*.=zy1.]k[wg,t,gG$|\">result</variable><variable id=\"-}U80Sowc,sXSlZU7GQW\">i</variable><variable id=\")wAlOg!YY1s~KGlhnq?4\">framebuffer</variable><variable id=\"~u[}rMLc:Ka,KETg%bQ0\">page</variable><variable id=\"2}l*zkXHGHHd{Ac%0fIh\">index</variable><variable id=\"[b0p~sWnX}Z3!X)q+Y3~\">bit</variable><variable id=\"IbJO_*X5DxY{(,3FOyT?\">dx</variable><variable id=\"mQ|