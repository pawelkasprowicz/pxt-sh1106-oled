-------\n// Rysowanie pojedynczego piksela\n// ------------------------------------------\nfunction oledPixel (x: number, y: number) {\n    if (x < 0 || x >= 128 || y < 0 || y >= 64) {\n        return\n    }\n    page = Math.idiv(y, 8)\n    index = page * 128 + x\n    bit = y % 8\n    framebuffer[index] |= (1 << bit)\n}\n// ------------------------------------------\n// Inicjalizacja SH1106\n// ------------------------------------------\nfunction oledInit () {\n    serial.writeLine(\"SH1106 INIT START\")\n    oledCommand(174)\n    oledCommand(213)\n    oledCommand(128)\n    oledCommand(168)\n    oledCommand(63)\n    oledCommand(211)\n    oledCommand(0)\n    oledCommand(64)\n    oledCommand(173)\n    oledCommand(139)\n    oledCommand(161)\n    oledCommand(200)\n    oledCommand(218)\n    oledCommand(18)\n    oledCommand(129)\n    oledCommand(128)\n    oledCommand(217)\n    oledCommand(31)\n    oledCommand(219)\n    oledCommand(64)\n    oledCommand(164)\n    oledCommand(166)\n    oledCommand(175)\n    serial.writeLine(\"SH1106 INIT OK\")\n}\n// ------------------------------------------\n// Prosta czcionka 5x7\n// Litery: H E L O\n// ------------------------------------------\nfunction oledChar (ch: string, x: number, y: number) {\n    if (ch == \"H\") {\n        data = [\n        127,\n        8,\n        8,\n        8,\n        127\n        ]\n    } else if (ch == \"E\") {\n        data = [\n        127,\n        73,\n        73,\n        73,\n        65\n        ]\n    } else if (ch == \"L\") {\n        data = [\n        127,\n        64,\n        64,\n        64,\n        64\n        ]\n    } else if (ch == \"O\") {\n        data = [\n        62,\n        65,\n        65,\n        65,\n        62\n        ]\n    }\n    for (let col = 0; col <= data.length - 1; col++) {\n        for (let row = 0; row <= 6; row++) {\n            if ((data[col] & (1 << row)) != 0) {\n                oledPixel(x + col, y + row)\n            }\n        }\n    }\n}\n// ------------------